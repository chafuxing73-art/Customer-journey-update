# 锦联 ERP 接口配置
EXTERNAL_ERP_BASE_URL=https://prod.jlfba.com
EXTERNAL_ERP_TOKEN=your-erp-token
EXTERNAL_ERP_MAC_ADDR=your-mac-address
EXTERNAL_ERP_USERNAME=your-username
EXTERNAL_ERP_PASSWORD_MD5=your-md5-password
# 锦联客户端版本号获取地址（启动时拉取最新 version，用于 erpversion header）
ERP_VERSION_URL=https://jl-test-buket.oss-cn-beijing.aliyuncs.com/version/latest.yml

# 企微 API（用于后续扩展，当前同步走 webhook，无需这些）
QWAI_CORP_ID=your-corp-id
QWAI_AGENT_ID=your-agent-id
QWAI_SECRET=your-secret

# 用户与鉴权（首次启动会用 ADMIN_USERNAME/ADMIN_PASSWORD 创建管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026
# JWT 签名密钥：必须改为随机字符串，缺失则服务拒绝启动
JWT_SECRET=please-change-this-to-a-random-32-byte-string
JWT_EXPIRE_DAYS=7

# 同步默认参数
SYNC_DEFAULT_PAGE_SIZE=500
SYNC_LOOKBACK_DAYS=30
LOG_LEVEL=INFO
